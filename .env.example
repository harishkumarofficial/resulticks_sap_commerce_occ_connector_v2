IS_PRODUCTION_ENV=0
SAP_USE_MOCK_DATA=1
SAP_ALLOW_NETWORK_IN_NON_PRODUCTION=0
SAP_BASE_URL=https://your-commerce-host
SAP_OCC_PREFIX=/occ/v2
SAP_BASE_SITE_ID=your-base-site
SAP_OAUTH_TOKEN_URL=https://your-commerce-host/authorizationserver/oauth/token
SAP_OAUTH_GRANT_TYPE=client_credentials
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_USERNAME=
SAP_PASSWORD=
SAP_PAGE_SIZE=100
SAP_MAX_PAGES=100
SAP_FIELDS=DEFAULT
SAP_TIMEOUT_SECONDS=30
SAP_VERIFY_TLS=1
SAP_USER_IDS=
SAP_OUTPUT_DIR=output
